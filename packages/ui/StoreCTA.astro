---
import type {Messages} from '../i18n/messages';
import type {AppConfig} from '../config/app';
interface Props {t:Messages;stores:AppConfig['stores'];}
const {t,stores}=Astro.props;
---
<section id="download" class="download wrap"><div><span class="eyebrow">SIMPLE CBT-I</span><h2>{t.downloadTitle}</h2><p>{t.downloadBody}</p></div>
<div class="store-area">{stores.apple&&<a class="store-link" href={stores.apple}>App Store <span aria-hidden="true">↗</span></a>}{stores.google&&<a class="store-link" href={stores.google}>Google Play <span aria-hidden="true">↗</span></a>}{!stores.apple&&!stores.google&&<p class="pending">{t.unavailable}</p>}</div></section>

