---
import type {Messages} from '../i18n/messages';
interface Props {t:Messages;locale:string;name:string;}
const {t,locale,name}=Astro.props;
---
<footer class="wrap footer"><div><a class="brand" href={'/'+locale+'/'}><span class="brand-icon" aria-hidden="true">☾</span>{name}</a><p>© {new Date().getFullYear()} {name}</p></div><nav aria-label={t.faq}><a href="#features">{t.features}</a><a href="#faq">{t.faq}</a><a href="#download">{t.cta}</a></nav></footer>

