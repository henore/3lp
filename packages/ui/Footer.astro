---
import type {Messages} from '../i18n/messages';
import {contactLabels} from '../config/support';
import {legalLinks} from '../config/legal';
interface Props {t:Messages;locale:string;name:string;icon?:string;privacyUrl?:string;}
const {t,locale,name,icon,privacyUrl=legalLinks.privacy}=Astro.props;
---
<footer class="wrap footer"><div><a class="brand" href={'/'+locale+'/'}>{icon ? <img class="brand-image" src={icon} alt="" width="39" height="39"/> : <span class="brand-icon" aria-hidden="true">☾</span>}{name}</a><p>© {new Date().getFullYear()} {name}</p></div><nav aria-label={t.faq}><a href="#features">{t.features}</a><a href="#faq">{t.faq}</a><a href="#download">{t.cta}</a><a href={'/'+locale+'/support/'}>{contactLabels[locale] ?? contactLabels.en}</a>{privacyUrl&&<a href={privacyUrl}>Privacy Policy</a>}{legalLinks.terms&&<a href={legalLinks.terms}>Terms</a>}</nav></footer>
