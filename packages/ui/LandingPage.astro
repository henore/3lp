---
import Header from './Header.astro';
import Seo from './Seo.astro';
import Footer from './Footer.astro';
import FeatureCard from './FeatureCard.astro';
import FAQ from './FAQ.astro';
import StoreCTA from './StoreCTA.astro';
import GooglePlayBadge from './GooglePlayBadge.astro';
import type {AppConfig} from '../config/app';
import type {Messages} from '../i18n/messages';
import {direction,type Locale} from '../i18n/locales';

import styles from './styles.css?inline';
interface Props {locale:Locale;app:AppConfig;t:Messages;theme?:string;joinUrl?:string;joinLabel?:string;storeNotice?:string;featureIcons?:Array<"diary"|"chart"|"book"|"timer"|"bell">;defaultLocale?:Locale;}
const {locale,app,t,theme="",joinUrl,joinLabel,storeNotice,featureIcons=["diary","chart","book"],defaultLocale}=Astro.props;
---
<!doctype html>
<html lang={locale} dir={direction(locale)}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content={app.accent}/><link rel="icon" href="/favicon.png"/><Seo name={app.name} title={app.name+' — '+t.title} description={t.intro} locale={locale} site={Astro.site} defaultLocale={defaultLocale}/><style is:inline set:html={styles}/><style is:inline set:html={theme}/></head>
<body data-brand={app.slug} style={'--accent:'+app.accent}>
 {t.notice && <div class="review-note">{t.notice}</div>}
 <div class="wrap"><Header locale={locale} t={t} name={app.name} icon={app.icon}/></div>
 <main id="main">
 <section class="hero wrap">
 <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{t.eyebrow}</p><h1>{t.title}<span>{t.highlight}</span></h1><p class="intro">{t.intro}</p><div class="hero-actions">{app.googleBadge && app.stores.google ? <GooglePlayBadge url={app.stores.google} locale={locale} label={t.cta}/> : <a class="button" href="#download">{t.cta}<span aria-hidden="true">↗</span></a>}<a class="text-link" href="#features">{t.secondary}<span aria-hidden="true">↓</span></a></div><p class="hero-note"><span aria-hidden="true">✓</span>{t.note}</p></div>
 <slot name="preview"/>
 </section>
 <section id="features" class="features section wrap"><div class="section-heading"><div><span class="eyebrow">01 / {t.features}</span><h2>{t.sectionTitle}</h2></div><p>{t.sectionIntro}</p></div><div class="feature-grid"><FeatureCard number="01" icon={featureIcons[0]} title={t.diary} body={t.diaryBody}/><FeatureCard number="02" icon={featureIcons[1]} title={t.patterns} body={t.patternsBody}/><FeatureCard number="03" icon={featureIcons[2]} title={t.learn} body={t.learnBody}/></div><slot name="feature-detail"/></section>
 <section id="approach" class="approach"><div class="wrap approach-inner"><div><span class="eyebrow">02 / {t.approach}</span><h2>{t.approachTitle}</h2><p>{t.approachBody}</p></div><ol class="steps">{[t.step1,t.step2,t.step3].map((step,i)=><li><span class="step-number">{'0'+(i+1)}</span><span>{step}</span><span class="step-mark" aria-hidden="true">{['↗','⌁','✧'][i]}</span></li>)}</ol></div></section>
 <FAQ t={t}/><StoreCTA googleBadge={app.googleBadge} locale={locale} t={t} stores={app.stores} name={app.name} joinUrl={joinUrl} joinLabel={joinLabel} notice={storeNotice}/>
 </main>
 <Footer t={t} locale={locale} name={app.name} icon={app.icon}/>
</body>
</html>


