---
import fs from 'node:fs';
import {fileURLToPath} from 'node:url';
import {screenCopy} from '../../../../packages/i18n/fasting-screens';
import type {Locale} from '../../../../packages/i18n/locales';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const t=screenCopy[locale];
const ssDir=fileURLToPath(new URL('../../public/screenshots',import.meta.url));
const ssLocale=fs.existsSync(ssDir+'/'+locale) ? locale : 'en';
---
<figure class="preview-scene actual-preview">
 <div class="orbital orbital-one" aria-hidden="true"></div><div class="orbital orbital-two" aria-hidden="true"></div>
 <div class="phone screenshot-phone" dir="ltr"><img src={'/screenshots/'+ssLocale+'/timer.jpg'} alt={t[1]} width="876" height="1800" fetchpriority="high"/></div>
 <figcaption>{t[0]}</figcaption>
</figure>
