---
import {screenCopy} from '../../../../packages/i18n/fasting-screens';
import type {Locale} from '../../../../packages/i18n/locales';
interface Props {locale:Locale;}
const t=screenCopy[Astro.props.locale];
---
<figure class="preview-scene actual-preview">
 <div class="orbital orbital-one" aria-hidden="true"></div><div class="orbital orbital-two" aria-hidden="true"></div>
 <div class="phone screenshot-phone" dir="ltr"><img src="/screenshots/timer.png" alt={t[1]} width="876" height="1800" fetchpriority="high"/></div>
 <figcaption>{t[0]}</figcaption>
</figure>

