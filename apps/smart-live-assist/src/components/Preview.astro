---
import fs from 'node:fs';
import type {Messages} from '../../../../packages/i18n/messages';
import type {Locale} from '../../../../packages/i18n/locales';
interface Props {t:Messages;locale:Locale;}
const {t,locale}=Astro.props;
const ssLocale=fs.existsSync('public/screenshots/'+locale) ? locale : 'en';
---
<figure class="preview-scene sla-preview"><div class="orbital orbital-one" aria-hidden="true"></div><div class="orbital orbital-two" aria-hidden="true"></div><div class="phone sla-phone" dir="ltr"><img src={'/screenshots/'+ssLocale+'/reader.png'} alt={t.diary+' — Reader'} width="892" height="1834" fetchpriority="high"/></div><figcaption>{t.preview}</figcaption></figure>
