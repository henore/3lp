---
import fs from 'node:fs';
import type {Messages} from '../../../../packages/i18n/messages';
import type {Locale} from '../../../../packages/i18n/locales';
interface Props {t:Messages;locale:Locale;}
const {t,locale}=Astro.props;
const ssLocale=fs.existsSync('public/screenshots/'+locale) ? locale : 'en';
const screens=[{name:'auto-tap',title:'Auto Tap',text:t.learnBody},{name:'guide',title:'Guide',text:t.approachBody},{name:'upgrade',title:'Lite / Global',text:t.a2}];
---
<div class="sla-gallery"><h3>{t.secondary}</h3><p class="sla-disclosure">{t.preview}</p><div class="sla-screen-grid">{screens.map(s=><figure class="sla-screen-card"><a class="sla-screen-image" href={'/screenshots/'+ssLocale+'/'+s.name+'.png'}><img src={'/screenshots/'+ssLocale+'/'+s.name+'.png'} alt={s.title+' — '+s.text} width="892" height="1834" loading="lazy" decoding="async"/></a><figcaption><strong lang="en">{s.title}</strong><p>{s.text}</p></figcaption></figure>)}</div></div>
