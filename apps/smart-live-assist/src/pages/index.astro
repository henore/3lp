---
import Home from '../components/Home.astro';
---
<Home locale="ja"/>
<script is:inline>
(function(){
  var s=new Set(['ja','en','zh-CN','zh-TW','ko','de','fr','es','it','pt-BR','nl','sv','pl','ru','ar','hi']);
  var m={'zh':'zh-CN','pt':'pt-BR'};
  var ls=navigator.languages||[navigator.language];
  for(var i=0;i<ls.length;i++){
    var l=ls[i];
    if(s.has(l)){if(l!=='ja')location.replace('/'+l+'/');return}
    if(m[l]){location.replace('/'+m[l]+'/');return}
    var p=l.split('-')[0];
    if(s.has(p)){if(p!=='ja')location.replace('/'+p+'/');return}
  }
})();
</script>
