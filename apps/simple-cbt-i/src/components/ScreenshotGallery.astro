---
import fs from 'node:fs';
import {fileURLToPath} from 'node:url';
import type {CbtiMessages} from '../../../../packages/i18n/cbti';
import type {Locale} from '../../../../packages/i18n/locales';
import {cbtiScreenCaption} from '../../../../packages/i18n/cbti-screens';
interface Props {t:CbtiMessages;locale:Locale;}
const {t,locale}=Astro.props;
const ssDir=fileURLToPath(new URL('../../public/screenshots',import.meta.url));
const ssLocale=fs.existsSync(ssDir+'/'+locale) ? locale : 'en';
const screens=[{name:'history',title:'History',description:t.diaryBody},{name:'stats',title:'Stats — Weekly averages',description:t.patternsBody},{name:'stats-trend',title:'Stats — Sleep efficiency trend',description:t.patternsBody}];
---
<div class="cbti-gallery">
<h3>{t.patterns}</h3><p class="cbti-screen-note">{cbtiScreenCaption[locale]}</p>
<div class="cbti-screen-grid">
{screens.map(s=><figure class="cbti-screen-card"><a class="cbti-screen-image" href={'/screenshots/'+ssLocale+'/'+s.name+'.jpg'}><img src={'/screenshots/'+ssLocale+'/'+s.name+'.jpg'} alt={s.title+' — '+s.description} width="720" height="1560" loading="lazy" decoding="async"/></a><figcaption><strong lang="en">{s.title}</strong><p>{s.description}</p></figcaption></figure>)}
</div>
</div>

