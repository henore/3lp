---
import fs from 'node:fs';
import {fileURLToPath} from 'node:url';
import type {CbtiMessages} from '../../../../packages/i18n/cbti';
import type {Locale} from '../../../../packages/i18n/locales';
import {cbtiScreenCaption} from '../../../../packages/i18n/cbti-screens';
interface Props{t:CbtiMessages;locale:Locale;}
const {t,locale}=Astro.props;
const ssDir=fileURLToPath(new URL('../../apps/simple-cbt-i/public/screenshots',import.meta.url));
const ssLocale=fs.existsSync(ssDir+'/'+locale) ? locale : 'en';
---
<figure class="preview-scene cbti-preview">
<div class="orbital orbital-one" aria-hidden="true"></div><div class="orbital orbital-two" aria-hidden="true"></div>
<div class="phone cbti-screen-phone" dir="ltr"><img src={'/screenshots/'+ssLocale+'/main.jpg'} alt={t.diary+' — Daily Insight'} width="720" height="1560" fetchpriority="high"/></div>
<figcaption>{cbtiScreenCaption[locale]}</figcaption>
</figure>

