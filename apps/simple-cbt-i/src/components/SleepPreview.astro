---
import type {Messages} from '../../../../packages/i18n/messages';
import type {Locale} from '../../../../packages/i18n/locales';
import {cbtiScreenCaption} from '../../../../packages/i18n/cbti-screens';
interface Props{t:Messages;locale:Locale;}
const {t,locale}=Astro.props;
---
<figure class="preview-scene cbti-preview">
<div class="orbital orbital-one" aria-hidden="true"></div><div class="orbital orbital-two" aria-hidden="true"></div>
<div class="phone cbti-screen-phone" dir="ltr"><img src="/screenshots/main.jpg" alt={t.diary+' — Daily Insight'} width="720" height="1560" fetchpriority="high"/></div>
<figcaption>{cbtiScreenCaption[locale]}</figcaption>
</figure>

