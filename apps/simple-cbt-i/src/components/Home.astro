---
import fs from 'node:fs';
import path from 'node:path';
import Header from '../../../../packages/ui/Header.astro';
import Seo from '../../../../packages/ui/Seo.astro';
import Footer from '../../../../packages/ui/Footer.astro';
import FeatureCard from '../../../../packages/ui/FeatureCard.astro';
import GooglePlayBadge from '../../../../packages/ui/GooglePlayBadge.astro';
import {app} from '../../../../packages/config/app';
import {cbtiMessages, type CbtiMessages} from '../../../../packages/i18n/cbti';
import {direction, type Locale} from '../../../../packages/i18n/locales';
import SleepPreview from './SleepPreview.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
import baseStyles from '../../../../packages/ui/styles.css?inline';
import theme from './screens.css?inline';
import {cbtiPurpose} from '../../../../packages/i18n/cbti-purpose';
import {cbtiProBenefits} from '../../../../packages/i18n/cbti-pro';
import {watchCopy} from '../../../../packages/i18n/cbti-watch';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const t:CbtiMessages={...cbtiMessages[locale],notice:''};
const ssDir=path.resolve('apps/simple-cbt-i/public/screenshots');
const ssLocale=fs.existsSync(ssDir+'/'+locale) ? locale : 'en';
const watch=watchCopy[locale];
const watchLocale=fs.existsSync(ssDir+'/'+locale+'/main2.jpg') ? locale : 'en';
const faq:Array<[string,string]>=[[t.q1,t.a1],[t.q2,t.a2],[t.q3,t.a3],[t.q4,t.a4],[t.q5,t.a5]];
---
<!doctype html>
<html lang={locale} dir={direction(locale)}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content={app.accent}/><link rel="icon" href="/favicon.png"/><Seo name={app.name} title={app.name+' — '+t.title+' '+t.highlight} description={t.intro} locale={locale} site={Astro.site} defaultLocale="en"/><style is:inline set:html={baseStyles}/><style is:inline set:html={theme}/></head>
<body data-brand={app.slug} style={'--accent:'+app.accent}>
 <div class="wrap"><Header locale={locale} t={t} name={app.name}/></div>
 <main id="main">

 <section class="hero wrap">
 <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{t.eyebrow}</p><h1><span>{t.highlight}</span><span class="hero-definition">{cbtiPurpose[locale]}</span></h1><p class="intro">{t.intro}</p><div class="hero-actions">{app.googleBadge && app.stores.google ? <GooglePlayBadge url={app.stores.google} locale={locale} label={t.cta}/> : <a class="button" href="#download">{t.cta}<span aria-hidden="true">↗</span></a>}<a class="text-link" href="#features">{t.secondary}<span aria-hidden="true">↓</span></a></div><p class="hero-note"><span aria-hidden="true">✓</span>{t.note}</p></div>
 <SleepPreview t={t} locale={locale}/>
 </section>

 <section id="features" class="features section wrap"><div class="section-heading"><div><span class="eyebrow">01 / {t.features}</span><h2>{t.sectionTitle}</h2></div><p>{t.sectionIntro}</p></div><div class="feature-grid"><FeatureCard number="01" icon="diary" title={t.diary} body={t.diaryBody}/><FeatureCard number="02" icon="chart" title={t.patterns} body={t.patternsBody}/><FeatureCard number="03" icon="book" title={t.learn} body={t.learnBody}/></div></section>

 <section class="insight-section"><div class="wrap insight-inner"><div class="insight-copy"><span class="eyebrow insight-eyebrow">02 / AI Daily Insight</span><h2>{t.insightDetailTitle}</h2><p>{t.insightDetailBody}</p><p class="insight-note"><span aria-hidden="true">✦</span>{t.insightDetailNote}</p></div><figure class="insight-phone"><div class="phone cbti-screen-phone" dir="ltr"><img src={'/screenshots/'+ssLocale+'/insight.jpg'} alt={'AI Daily Insight — '+t.insightDetailBody} width="720" height="1560" loading="lazy" decoding="async"/></div></figure></div></section>

 <section id="watch-sync" class="watch-section"><div class="wrap insight-inner"><div class="insight-copy"><span class="eyebrow">03 / Apple Watch &amp; Smartwatch</span><h2>{watch.title}</h2><p>{watch.body}</p><p class="watch-note">{watch.note}</p></div><figure class="insight-phone"><div class="phone cbti-screen-phone" dir="ltr"><img src={'/screenshots/'+watchLocale+'/main2.jpg'} alt={watch.body} width="720" height="1560" loading="lazy" decoding="async"/></div></figure></div></section>
 <section id="approach" class="approach"><div class="wrap approach-inner"><div><span class="eyebrow">04 / {t.approach}</span><h2>{t.approachTitle}</h2><p>{t.approachBody}</p></div><ol class="steps">{[t.step1,t.step2,t.step3].map((step,i)=><li><span class="step-number">{'0'+(i+1)}</span><span>{step}</span><span class="step-mark" aria-hidden="true">{['↗','⌁','✧'][i]}</span></li>)}</ol></div></section>

 <section class="trends section wrap"><div class="section-heading"><div><span class="eyebrow">05 / Stats</span><h2>{t.trendTitle}</h2></div><p>{t.trendBody}</p></div><ScreenshotGallery t={t} locale={locale}/></section>

 <section class="guide-section section wrap"><div class="guide-inner"><div class="section-heading"><div><span class="eyebrow">06 / {t.guideTitle}</span><h2>{t.guideFullName}</h2></div><p>{t.guideBody}</p></div><figure class="guide-phone"><div class="phone cbti-screen-phone" dir="ltr"><img src={'/screenshots/'+ssLocale+'/detail.jpg'} alt={t.guideFullName} width="720" height="1560" loading="lazy" decoding="async"/></div></figure></div></section>

 <section class="not-section"><div class="wrap not-inner"><h2>{t.notTitle}</h2><ul class="not-list">{[t.notMic,t.notSnoring,t.notSounds,t.notStages,t.notProgram].map(item=><li><span aria-hidden="true">✕</span>{item}</li>)}</ul><p class="not-instead">{t.notInstead}</p></div></section>

 <section class="plan-section section wrap"><span class="eyebrow">{t.planTitle}</span><div class="plan-grid"><div class="plan-card"><h3>{t.freeLabel}</h3><ul>{[t.freeItem1,t.freeItem2,t.freeItem3,t.freeItem4,t.freeItem5].map(item=><li><span aria-hidden="true">✓</span>{item}</li>)}</ul></div><div class="plan-card plan-pro"><h3>{t.proLabel}</h3><ul>{cbtiProBenefits[locale].map(([title,description])=><li><span aria-hidden="true">✦</span><div class="pro-benefit-copy"><strong>{title}</strong><p>{description}</p></div></li>)}</ul></div></div></section>

 <section class="trust-section section wrap"><h2>{t.dataTitle}</h2><div class="trust-grid"><div class="trust-backup"><h3>{t.backupLabel}</h3><p>{t.backupBody}</p></div><div class="trust-privacy">{[t.privacyNoAccount,t.privacyNoMic,t.privacyMinimal].map(item=><p><span aria-hidden="true">✓</span>{item}</p>)}</div></div></section>

 <section class="faq section wrap" id="faq"><div><span class="eyebrow">FAQ</span><h2>{t.faqTitle}</h2></div><div class="questions">{faq.map(([q,a])=><details><summary>{q}<span class="plus" aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section>

 <section id="download" class="download wrap"><div><span class="eyebrow">{app.name.toUpperCase()}</span><h2>{t.downloadTitle}</h2><p>{t.downloadBody}</p></div><div class="store-area">{app.stores.google ? (app.googleBadge ? <GooglePlayBadge url={app.stores.google} locale={locale} label={t.cta}/> : <a class="store-link" href={app.stores.google}>Google Play <span aria-hidden="true">↗</span></a>) : <p class="pending">{t.unavailable}</p>}</div></section>
 </main>

 <div class="disclaimer-bar"><p class="wrap">{t.disclaimer}</p></div>
 <Footer t={t} locale={locale} name={app.name}/>
</body>
</html>
