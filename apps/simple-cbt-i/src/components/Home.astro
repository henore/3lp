---
import Header from '../../../../packages/ui/Header.astro';
import Seo from '../../../../packages/ui/Seo.astro';
import Footer from '../../../../packages/ui/Footer.astro';
import FeatureCard from '../../../../packages/ui/FeatureCard.astro';
import FAQ from '../../../../packages/ui/FAQ.astro';
import StoreCTA from '../../../../packages/ui/StoreCTA.astro';
import {app} from '../../../../packages/config/app';
import {messages} from '../../../../packages/i18n/messages';
import {direction,type Locale} from '../../../../packages/i18n/locales';
import SleepPreview from './SleepPreview.astro';
import styles from '../../../../packages/ui/styles.css?inline';
interface Props {locale:Locale;}
const {locale}=Astro.props; const t=messages[locale];
---
<!doctype html>
<html lang={locale} dir={direction(locale)}>
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#111f3c"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><Seo name={app.name} title={app.name+' — '+t.title} description={t.intro} locale={locale} site={Astro.site}/><style is:inline set:html={styles}/></head>
<body style={'--accent:'+app.accent}>
 <div class="review-note">{t.notice}</div>
 <div class="wrap"><Header locale={locale} t={t} name={app.name}/></div>
 <main id="main">
 <section class="hero wrap">
 <div class="hero-copy"><p class="eyebrow"><span class="eyebrow-line" aria-hidden="true"></span>{t.eyebrow}</p><h1>{t.title}<span>{t.highlight}</span></h1><p class="intro">{t.intro}</p><div class="hero-actions"><a class="button" href="#download">{t.cta}<span aria-hidden="true">↗</span></a><a class="text-link" href="#features">{t.secondary}<span aria-hidden="true">↓</span></a></div><p class="hero-note"><span aria-hidden="true">✓</span>{t.note}</p></div>
 <SleepPreview t={t} locale={locale}/>
 </section>
 <section id="features" class="features section wrap"><div class="section-heading"><div><span class="eyebrow">01 / {t.features}</span><h2>{t.sectionTitle}</h2></div><p>{t.sectionIntro}</p></div><div class="feature-grid"><FeatureCard number="01" icon="diary" title={t.diary} body={t.diaryBody}/><FeatureCard number="02" icon="chart" title={t.patterns} body={t.patternsBody}/><FeatureCard number="03" icon="book" title={t.learn} body={t.learnBody}/></div></section>
 <section id="approach" class="approach"><div class="wrap approach-inner"><div><span class="eyebrow">02 / {t.approach}</span><h2>{t.approachTitle}</h2><p>{t.approachBody}</p></div><ol class="steps">{[t.step1,t.step2,t.step3].map((step,i)=><li><span class="step-number">{'0'+(i+1)}</span><span>{step}</span><span class="step-mark" aria-hidden="true">{['↗','⌁','✧'][i]}</span></li>)}</ol></div></section>
 <FAQ t={t}/><StoreCTA t={t} stores={app.stores}/>
 </main>
 <Footer t={t} locale={locale} name={app.name}/>
</body>
</html>

